# Caddyfile — reverse proxy + TLS WILDCARD via Cloudflare DNS-01.
# {$DOMAIN} et {$CLOUDFLARE_API_TOKEN} viennent de l'environnement (cf. .env).
#
# /!\ Sous-domaines à UN SEUL niveau (lab1.{$DOMAIN}, …) — couverts par le
#     certificat Universal SSL gratuit de Cloudflare (*.{$DOMAIN}).
#     Un schéma à deux niveaux (1.lab.{$DOMAIN}) n'est PAS couvert par l'Universal
#     SSL gratuit → handshake failure côté edge. D'où lab1, lab2, …
#
# Topologie : Cloudflare (proxy : DDoS/WAF, cache l'IP, TLS edge)  →  ce Caddy
# (route par sous-domaine vers les conteneurs). Le challenge DNS-01 obtient un
# certificat *.{$DOMAIN} côté origine qui fonctionne derrière le proxy.
#
# Prérequis Cloudflare :
#   - DNS proxifié (orange) :  {$DOMAIN} A <IP_VPS>  et  *.{$DOMAIN} A <IP_VPS>
#   - SSL/TLS mode : Full (strict)  (au moins pour les hôtes lab*)
#   - API token (scope Zone:DNS:Edit sur la zone) → CLOUDFLARE_API_TOKEN dans .env

# Snippet réutilisable : config TLS Cloudflare (cert wildcard via DNS-01).
(cf_tls) {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
}

# Snippet : /proxy/<port> (sans slash final) → /proxy/<port>/
# Sans le slash, le navigateur résout les liens relatifs (css/app.css) en
# /proxy/css/app.css → code-server cherche le « port » css → 500.
(proxy_slash) {
	@proxy_noslash path_regexp ^/(abs)?proxy/[0-9]+$
	redir @proxy_noslash {path}/{?query} 308
}

# Un site par stagiaire → son code-server (port 13337).
# Le poste partage le réseau de son DinD (network_mode) → on le joint via dind-N.
# Conteneurs du stagiaire : https://labN.{$DOMAIN}/proxy/<port>/ (proxy code-server, protégé par mot de passe).
lab1.{$DOMAIN} {
	import cf_tls
	import proxy_slash
	reverse_proxy dind-1:13337
}
lab2.{$DOMAIN} {
	import cf_tls
	import proxy_slash
	reverse_proxy dind-2:13337
}
lab3.{$DOMAIN} {
	import cf_tls
	import proxy_slash
	reverse_proxy dind-3:13337
}
lab4.{$DOMAIN} {
	import cf_tls
	import proxy_slash
	reverse_proxy dind-4:13337
}
lab5.{$DOMAIN} {
	import cf_tls
	import proxy_slash
	reverse_proxy dind-5:13337
}
lab6.{$DOMAIN} {
	import cf_tls
	import proxy_slash
	reverse_proxy dind-6:13337
}
lab7.{$DOMAIN} {
	import cf_tls
	import proxy_slash
	reverse_proxy dind-7:13337
}
lab8.{$DOMAIN} {
	import cf_tls
	import proxy_slash
	reverse_proxy dind-8:13337
}
lab9.{$DOMAIN} {
	import cf_tls
	import proxy_slash
	reverse_proxy dind-9:13337
}
lab10.{$DOMAIN} {
	import cf_tls
	import proxy_slash
	reverse_proxy dind-10:13337
}

# Console LocalStack partagée
labls.{$DOMAIN} {
	import cf_tls
	reverse_proxy localstack:4566
}

# Conteneurs des stagiaires par SOUS-DOMAINE : labN-PORT.{$DOMAIN} → code-server du
# poste N (dind-N:13337), qui vérifie la connexion puis relaie vers localhost:PORT
# (option --proxy-domain labN-{{port}}.DOMAIN, cf. compose PROXY_DOMAIN).
# L'app est servie à la RACINE « / » → SPA et appels absolus (fetch('/items')) OK,
# contrairement à /proxy/<port>/. Protégé par le mot de passe du poste (1 login par
# sous-domaine : le cookie de labN.DOMAIN n'est pas partagé — ni avec les autres labs).
# 1 seul niveau de sous-domaine → couvert par le cert wildcard / Universal SSL.
# Les blocs labN.{$DOMAIN} ci-dessus, plus précis, restent prioritaires.
*.{$DOMAIN} {
	import cf_tls
	@labport header_regexp lp Host ^lab([0-9]+)-[0-9]+\.
	handle @labport {
		reverse_proxy dind-{re.lp.1}:13337
	}
	handle {
		respond "Not found" 404
	}
}
